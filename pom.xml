<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.joshuagrisham.kafka.connect</groupId>
    <artifactId>tink-crypto-transform</artifactId>
    <version>0.0.2</version>
    <name>Kafka Connect Google Tink Crypto Transform</name>
    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <compiler-plugin.version>3.12.1</compiler-plugin.version>
        <maven.compiler.release>11</maven.compiler.release>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <kafka.version>3.7.0</kafka.version>
        <tink.version>1.14.1</tink.version>
        <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>connect-transforms</artifactId>
            <version>${kafka.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.crypto.tink</groupId>
            <artifactId>tink</artifactId>
            <version>${tink.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>com.google.*</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.confluent</groupId>
                <version>0.12.0</version>
                <artifactId>kafka-connect-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <id>hub</id>
                        <goals>
                            <goal>kafka-connect</goal>
                        </goals>
                        <configuration>
                            <title>Tink Crypto Transform</title>
                            <description>
                                Single Message Transform (SMT) to encrypt or decrypt an entire value string or selected fields using the Google Tink cryptography library (https://developers.google.com/tink).
                            </description>
                            <documentationUrl>
                                https://github.com/joshuagrisham/kafka-connect-tink-crypto-transform/blob/main/README.md
                            </documentationUrl>
                            <sourceUrl>
                                https://github.com/joshuagrisham/kafka-connect-tink-crypto-transform
                            </sourceUrl>

                            <ownerUsername>joshuagrisham</ownerUsername>
                            <ownerType>user</ownerType>
                            <ownerName>Joshua Grisham</ownerName>
                            <ownerUrl>https://github.com/joshuagrisham</ownerUrl>

                            <kafkaConnectApi>false</kafkaConnectApi>
                            <componentTypes>
                                <componentType>transform</componentType>
                            </componentTypes>
                            <tags>
                                <tag>cipher</tag>
                                <tag>cryptography</tag>
                                <tag>AES</tag>
                                <tag>AES-GCM</tag>
                            </tags>
                            <confluentControlCenterIntegration>true</confluentControlCenterIntegration>
                            <singleMessageTransforms>true</singleMessageTransforms>
                            <supportedEncodings></supportedEncodings>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
